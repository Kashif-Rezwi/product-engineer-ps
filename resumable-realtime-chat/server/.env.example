# Server configuration — copy to .env and fill in values. Never commit real secrets.

# HTTP
PORT=3001
NODE_ENV=development
# CORS origin of the client
CLIENT_URL=http://localhost:3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/chat_db?schema=public"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Response generator selection:
#   GENERATOR=fake  -> deterministic fake generator (tests, benchmark, demo path)
#   otherwise       -> Groq when GROQ_API_KEY is set; fake generator when it is not
# GENERATOR=fake

# Groq (optional — the app falls back to the fake generator without a key)
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-20b"

# Fail a run when the generator produces no chunk for this long (ms)
# GENERATOR_IDLE_TIMEOUT_MS=30000

# Fake generator tuning (defaults shown)
# FAKE_GENERATOR_CHUNKS=35
# FAKE_GENERATOR_DELAY_MS=40
# FAKE_GENERATOR_FAIL_AFTER=  (fail after N chunks — useful for demoing AC5)
